rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: bookmarks
    // Document ID: auto-generated
    // Fields:
    //   - uid: string (required) - Owner's UID
    //   - surahNumber: number (required)
    //   - ayahNumber: number (required)
    //   - surahName: string (required)
    //   - timestamp: number (required)
    //
    // Collection: lastRead
    // Document ID: userId
    // Fields:
    //   - uid: string (required) - Owner's UID
    //   - surahNumber: number (required)
    //   - ayahNumber: number (required)
    //   - surahName: string (required)
    //   - timestamp: number (required)
    //
    // Collection: userSettings
    // Document ID: userId
    // Fields:
    //   - uid: string (required)
    //   - translation: string (optional)
    //   - reciter: string (optional)
    //   - theme: string (optional)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    // ===============================================================
    // Validation Functions
    // ===============================================================
    function isValidBookmark(data) {
      return data.keys().hasAll(['uid', 'surahNumber', 'ayahNumber', 'surahName', 'timestamp']) &&
             data.uid is string &&
             data.surahNumber is number &&
             data.ayahNumber is number &&
             data.surahName is string && data.surahName.size() < 100 &&
             data.timestamp is number;
    }

    function isValidLastRead(data) {
      return data.keys().hasAll(['uid', 'surahNumber', 'ayahNumber', 'surahName', 'timestamp']) &&
             data.uid is string &&
             data.surahNumber is number &&
             data.ayahNumber is number &&
             data.surahName is string && data.surahName.size() < 100 &&
             data.timestamp is number;
    }

    function isValidSettings(data) {
      return data.uid is string &&
             (!('translation' in data) || data.translation is string) &&
             (!('reciter' in data) || data.reciter is string) &&
             (!('theme' in data) || data.theme in ['light', 'dark', 'sepia']);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /bookmarks/{bookmarkId} {
      allow read: if isDocOwner();
      allow create: if isAuthenticated() && isValidBookmark(request.resource.data) && request.resource.data.uid == request.auth.uid;
      allow update: if isDocOwner() && isValidBookmark(request.resource.data) && uidNotModified();
      allow delete: if isDocOwner();
    }

    match /lastRead/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidLastRead(request.resource.data) && request.resource.data.uid == request.auth.uid;
    }

    match /userSettings/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidSettings(request.resource.data) && request.resource.data.uid == request.auth.uid;
    }
  }
}
